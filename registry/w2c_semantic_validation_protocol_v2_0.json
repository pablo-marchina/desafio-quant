    "CORPORATE_LITIGATION_BINARY": {
      "positive": ["lawsuit", "verdict", "injunction", "settlement", "court ruling", "court decision", "appeal", "bankruptcy", "chapter 11"],
      "hard_exclude": ["\\bvs\\.?\\b", "championship", "clay court", "court lions", "arrested", "sentencing", "supreme court vacancy", "election interference trial date", "antitrust", "ftc", "doj", "merger", "acquisition"]
    }
  },
  "multi_family_policy": {
    "same_mechanism_precedence": [
      ["MA_REGULATORY_CLEARANCE", "MA_PENDING_COMPLETION", "MA_PRE_ANNOUNCEMENT_OR_RUMOR"],
      ["FDA_FINAL_PDUFA_DECISION", "FDA_ADVISORY_COMMITTEE"]
    ],
    "rule": "Use precedence only when the highest-priority family's own strict title+slug rule passes and lower hits arise from shared mechanism vocabulary. Cross-mechanism hits remain AMBIGUOUS_MULTI_FAMILY."
  },
  "independence": {
    "cluster_key": "resolved_family + UTC end-date day + normalized title subject after removing numeric thresholds and generic probability boilerplate",
