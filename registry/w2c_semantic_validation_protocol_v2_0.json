    },
    "FDA_FINAL_PDUFA_DECISION": {
      "require_all": ["\\b(fda|food and drug administration|pdufa)\\b", "\\b(approve|approval|approved|authorize|authorization|emergency use authorization|eua|pdufa|action date|complete response|crl)\\b"],
      "advisory_exception": "If advisory terms also appear, final-action terms must explicitly refer to a distinct final FDA decision; otherwise ambiguous/reject."
    },
    "MA_PRE_ANNOUNCEMENT_OR_RUMOR": {
      "require_all": ["\\b(merger|acquisition|acquire|takeover)\\b", "\\b(announce|announced|announcement|rumou?r|bid|offer)\\b"],
      "hard_exclude": ["\\b(close|closing|completion|shareholder vote|tender offer|ftc|doj|antitrust|regulatory clearance|competition authority|european commission)\\b"]
    },
    "MA_PENDING_COMPLETION": {
      "require_all": ["\\b(merger|acquisition|takeover|transaction)\\b", "\\b(close|closing|complete|completion|shareholder vote|tender offer|outside date|terminate|termination)\\b"],
      "hard_exclude": ["\\b(ftc|doj|antitrust|regulatory clearance|competition authority|european commission)\\b"]
    },
    "MA_REGULATORY_CLEARANCE": {
      "require_all": ["\\b(merger|acquisition|transaction|takeover)\\b", "\\b(ftc|doj|antitrust|regulatory|competition authority|competition regulator|european commission|\\bcma\\b)\\b", "\\b(approve|approval|clear|clearance|block|challenge|second request|phase 2|remedy|remedies)\\b"]
    },
    "ANTITRUST_ENFORCEMENT_SINGLE_NAME": {
      "require_all": ["\\b(antitrust|ftc|doj|competition authority|competition regulator|monopoly)\\b", "\\b(lawsuit|sue|settle|settlement|divest|sell|investigation|enforcement|ruling|injunction|case|fine)\\b"],
      "hard_exclude": ["\\b(merger|acquisition|transaction|takeover)\\b", "earnings call", "app store.*rank"]
    },
    "FOMC_DECISION": {
      "require_all": ["\\b(fomc|federal reserve|fed)\\b", "\\b(decision|meeting|target rate|target range|rate cut|cut rates|rate hike|hike rates|hold rates|dissent)\\b"],
      "hard_exclude": ["emergency rate cut", "how many .*cuts.*year", "derivative", "favou?red", "cpi", "consumer price index", "payroll", "gdp", "retail sales"]
    },
    "MACRO_STATISTICAL_RELEASE": {
      "positive": ["\\bcpi\\b", "consumer price index", "u\\.?s\\.? inflation", "\\bppi\\b", "producer price index", "nonfarm payroll", "payrolls", "jobs added", "jobs report", "employment situation", "unemployment rate", "\\bgdp\\b", "gross domestic product", "retail sales"],
      "hard_exclude": ["\\bfomc\\b", "fed decision", "rate decision", "rate cut", "rate hike", "\\bvs\\.?\\b", "championship", "esports", "halftime"]
