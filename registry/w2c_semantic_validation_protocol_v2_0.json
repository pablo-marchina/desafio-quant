  "adjudication": {
    "required_before_F3": true,
    "states": ["ACCEPT_STRICT_FAMILY", "REJECT_FALSE_POSITIVE", "AMBIGUOUS_UNRESOLVED"],
    "queue_order": "SHA256(resolved_family + '|' + independence_cluster_id)",
    "initial_target_clusters_per_family": 100,
    "small_family_rule": "all provisional clusters if fewer than 100",
    "top_up_rule": "If fewer than 80 accepted clusters remain after adjudication and more provisional clusters exist, continue in the same frozen hash order until 80 accepts or exhaustion.",
