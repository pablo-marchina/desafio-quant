# Busca de fontes públicas com Tavily.
TAVILY_API_KEY=

# Geração de recomendações pela NVIDIA NIM API.
NVIDIA_API_KEY=

# Modelo usado na geração de recomendações.
NVIDIA_LLM_MODEL=meta/llama-3.1-8b-instruct

# Persistência e consulta do histórico no Supabase.
SUPABASE_URL=

# Configure uma das duas chaves de servidor abaixo.
# SUPABASE_SECRET_KEY tem precedência quando ambas estão definidas.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
