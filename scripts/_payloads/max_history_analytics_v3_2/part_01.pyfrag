import statsmodels.api as sm

ROOT = Path(__file__).resolve().parents[1]
REG = ROOT / 'registry'
OUT = REG / 'analytics' / 'max_history_v3_2'
SNAP = OUT / 'source_snapshot'
SNAP_ZIP = SNAP / 'max-history-backtest-v3.2-final.zip'
CACHE = OUT / '.source_cache'
OUT.mkdir(parents=True, exist_ok=True)
SNAP.mkdir(parents=True, exist_ok=True)
SEED=20260819
rng=np.random.default_rng(SEED)

CSV_INPUTS = [
    'presentation_demo_max_history_backtest_trades_v3.csv',
    'presentation_demo_max_history_backtest_errors_v3.csv',
    'presentation_demo_max_history_backtest_funnels_v3.csv',
    'presentation_demo_max_history_backtest_scorecard_v3.csv',
    'presentation_demo_max_history_backtest_yearly_v3.csv',
]
JSON_INPUTS = [
    'presentation_demo_max_history_backtest_summary_v3.json',
    'presentation_demo_max_history_forecastex_v3.json',
]

def ensure_cache() -> None:
    if CACHE.exists() and all((CACHE/n).exists() for n in CSV_INPUTS + JSON_INPUTS):
        return
    if not SNAP_ZIP.exists():
        raise FileNotFoundError(f'missing source snapshot archive: {SNAP_ZIP}')
    import zipfile
    CACHE.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(SNAP_ZIP) as z:
        z.extractall(CACHE)

def input_path(name: str) -> Path:
    root = REG / name
    if root.exists():
        return root
    ensure_cache()
    cached = CACHE / name
    if cached.exists():
        return cached
    raise FileNotFoundError(f'missing analytics input: {name}')

INPUT_PATHS = {name: input_path(name) for name in CSV_INPUTS + JSON_INPUTS}
trades=pd.read_csv(INPUT_PATHS['presentation_demo_max_history_backtest_trades_v3.csv'])
errors=pd.read_csv(INPUT_PATHS['presentation_demo_max_history_backtest_errors_v3.csv'])
funnels=pd.read_csv(INPUT_PATHS['presentation_demo_max_history_backtest_funnels_v3.csv'])
scorecard=pd.read_csv(INPUT_PATHS['presentation_demo_max_history_backtest_scorecard_v3.csv'])
yearly_base=pd.read_csv(INPUT_PATHS['presentation_demo_max_history_backtest_yearly_v3.csv'])
summary=json.loads(INPUT_PATHS['presentation_demo_max_history_backtest_summary_v3.json'].read_text())
