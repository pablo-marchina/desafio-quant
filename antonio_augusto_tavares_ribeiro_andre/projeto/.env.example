# LLM / NVIDIA
NVIDIA_API_KEY=                 # build.nvidia.com (créditos grátis)
NEMOTRON_MODEL_FAST=nvidia/llama-3.1-nemotron-nano-8b-v1
NEMOTRON_MODEL_REASON=nvidia/llama-3.3-nemotron-super-49b-v1
NV_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
NV_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# NIM self-hosted (GPU local) — opcional no build, usado no F6
NIM_BASE_URL=http://localhost:8000/v1

# Reranker: nemo (default no build) | cohere (somente validação F7)
RERANKER_PROVIDER=nemo
COHERE_API_KEY=                 # só na F7 (trial gratuita)

# Busca / scraping
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Dados
POSTGRES_URL=postgresql://tapi:tapi@localhost:5432/tapi
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Observabilidade (app — SDK Langfuse lê estas 3). Gere um par de chaves de projeto
# (ex.: python -c "import uuid;print('pk-lf-'+str(uuid.uuid4()));print('sk-lf-'+str(uuid.uuid4()))");
# o Compose usa as MESMAS para provisionar o projeto no 1º boot (headless, sem clicar na UI).
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse self-host (infra do docker-compose; interpolado pelo Compose, não pela app)
LANGFUSE_SALT=changeme
LANGFUSE_ENCRYPTION_KEY=    # 64 chars hex: openssl rand -hex 32  (ou python -c "import secrets;print(secrets.token_hex(32))")
LANGFUSE_NEXTAUTH_SECRET=changeme
LANGFUSE_INIT_USER_EMAIL=you@example.com   # admin da UI criado no 1º boot
LANGFUSE_INIT_USER_PASSWORD=changeme8+     # mín. 8 chars
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# Auth da ferramenta (gate interno — F5.9). Token compartilhado p/ API + UI.
TAPI_API_TOKEN=

# Idioma de saída (F0.13): briefing, recomendações e UI. Embeddings seguem multilíngues.
OUTPUT_LANG=pt-BR
