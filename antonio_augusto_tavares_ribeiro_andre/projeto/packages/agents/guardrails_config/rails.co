# Colang (F4.5) — fluxo do output rail de evidência do briefing TAPI.
# A decisão vem do custom action `check_recommendation_evidence` (actions.py), que reusa a espinha
# determinista `check_recommendations` (anti-alucinação). Bloqueia recomendação sem os dois lados.

define bot refuse unsupported recommendation
  "Recomendacao bloqueada pelo guardrail: sem evidencia dos dois lados (gap da startup E base NVIDIA)."

define flow check recommendation evidence
  """Bloqueia se houver recomendacao sem `evidencia_gap` E `evidencia_nvidia` (invariante F4.5)."""
  $allowed = execute check_recommendation_evidence
  if not $allowed
    bot refuse unsupported recommendation
    stop
