# Copie para .env e ajuste. O .env nao deve ser versionado.

# Conexao PostgreSQL (DSN asyncpg). Ex.: postgres://user:pass@host:5432/dbname
DATABASE_URL=postgres://radar:radar@localhost:5432/nvidia_radar
# --- Concorrencia / politeness ---
# Limite global de conexoes simultaneas do httpx.
MAX_CONNECTIONS=50
# Requisicoes simultaneas permitidas no PoliteFetcher (anti-bloqueio de IP).
PER_HOST_CONCURRENCY=8
# Janela de atraso (segundos) aplicada com jitter entre requisicoes.
POLITE_DELAY_MIN=0.2
POLITE_DELAY_MAX=0.8
# Timeout de cada requisicao (segundos).
REQUEST_TIMEOUT=20

# --- QFirst (filtro semantico) ---
QFIRST_THRESHOLD=0.45
SBERT_MODEL=all-MiniLM-L6-v2
# Maximo de candidatos novos avaliados na fase de busca aberta.
OPEN_SEARCH_MAX_CANDIDATES=300

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Opcional: chave para um provider de busca comercial (TavilyProvider, etc.)
# TAVILY_API_KEY=

# =============================================================================
# FASE 2 - Deep Extraction
# =============================================================================

# --- URL Discovery: pool de chaves com failover em 4 niveis ---
# Nivel 1 e 2: Tavily (https://app.tavily.com)
TAVILY_API_KEY_1=tvly-...
TAVILY_API_KEY_2=tvly-...
# Nivel 3 e 4: SerpAPI / Google (https://serpapi.com)
SERPAPI_API_KEY_1=...
SERPAPI_API_KEY_2=...

# --- Chunking (RAG) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Orquestrador de deep scan ---
# Numero de startups processadas simultaneamente (Semaphore).
DEEP_SCAN_CONCURRENCY=2
# Tamanho do lote buscado do banco por iteracao.
DEEP_SCAN_BATCH_SIZE=50

# =============================================================================
# FASE 2 - Vetorizacao (Qdrant + sentence-transformers)
# =============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Chunks por lote enviados ao modelo de embedding (all-MiniLM-L6-v2).
EMBED_BATCH_SIZE=64

# =============================================================================
# FASE 3 - Classificador LLM (fallback multi-provedor)
# =============================================================================

# --- OpenRouter (primario — 2 chaves para redundancia) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY_1=sk-or-v1-...
OPENROUTER_API_KEY_2=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free

# --- Ollama (secundario — local, sem rate limit/custo; requer 'ollama serve' rodando) ---
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# --- Groq (terciario — inferencia ultra-rapida; verifique saldo da chave) ---
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-8b-8192

# --- Gemini (quaternario — 2M de contexto; verifique quota gratuita) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# Provedor padrao quando nenhum --model for passado
DEFAULT_LLM_PROVIDER=openrouter

# --- Cohere Rerank (Fase 3 — pool de 2 chaves com failover) ---
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY_1=
COHERE_API_KEY_2=
