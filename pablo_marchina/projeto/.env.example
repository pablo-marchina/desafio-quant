# NVIDIA Startup AI Radar — production configuration template
# Copy to .env locally. Never commit real secrets.

# Runtime mode
APP_MODE=product
LOG_LEVEL=INFO
API_WORKERS=2
WORKFLOW_WORKER_POLL_SECONDS=2
WORKFLOW_NODE_MAX_RETRIES=2

# Internal API protection. Generate a random value with at least 32 characters.
# The browser never receives this value; Nginx injects it only on the internal proxy hop.
API_AUTH_MODE=internal_proxy
INTERNAL_PROXY_KEY=replace-with-a-random-value-of-at-least-32-characters

# Product database and durable LangGraph checkpointer.
# Replace the database placeholder everywhere with the same URL-safe random value.
POSTGRES_PASSWORD=replace-with-a-random-database-password
PRODUCT_DB_URL=postgresql+psycopg2://radar:replace-with-a-random-database-password@localhost:5432/nvidia_radar
LANGGRAPH_CHECKPOINTER=postgres
LANGGRAPH_POSTGRES_URL=postgresql://radar:replace-with-a-random-database-password@localhost:5432/nvidia_radar
AGENT_ORCHESTRATION_ENABLED=true

# RAG is mandatory for the only production pipeline.
RAG_REQUIRED_FOR_PRODUCT=true
RAG_VECTOR_BACKEND=qdrant
RAG_RETRIEVAL_MODE=bm25_graphrag_qdrant_triton_rerank
RAG_EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_URL=http://localhost:6333
# Required in production. The release initializer replaces this placeholder with a random key.
QDRANT_API_KEY=replace-with-a-random-qdrant-api-key
QDRANT_COLLECTION=nvidia_corpus
QDRANT_VECTOR_SIZE=1024
QDRANT_TIMEOUT_SECONDS=10
QDRANT_MIN_POINTS=10

# BM25 lexical retrieval
BM25_ENABLED=true
BM25_TOP_K=20
BM25_K1=1.5
BM25_B=0.75

# GraphRAG retrieval expansion over the NVIDIA corpus graph
GRAPHRAG_ENABLED=true
GRAPHRAG_MIN_CONTEXT_SCORE=0.0
GRAPHRAG_MAX_GRAPH_NEIGHBORS=6
GRAPHRAG_MIN_LINEAGE_PATHS=1

# NVIDIA Triton cross-encoder reranker. Required in APP_MODE=product.
RERANKER_PROVIDER=triton
RERANKER_MODEL=cross_encoder
TRITON_RERANKER_ENABLED=true
TRITON_RERANKER_REQUIRED=true
TRITON_RERANKER_URL=http://localhost:8000/v2/models/cross_encoder/infer
TRITON_RERANKER_HEALTH_URL=http://localhost:8000/v2/models/cross_encoder/ready
TRITON_RERANKER_MODEL=cross_encoder
TRITON_RERANKER_TIMEOUT_SECONDS=8
TRITON_RERANKER_SCORE_INPUT_NAME=scores
TRITON_RERANKER_TEXT_INPUT_NAME=documents
TRITON_RERANKER_QUERY_INPUT_NAME=query

# LLM/API providers. Configure at least one provider used by enabled techniques.
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Governed scraping providers. Optional providers must be configured before enabling them.
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
GITHUB_TOKEN=
RADAR_ANALYSIS_MAX_SOURCES=5
SCRAPING_MIN_RAW_EVIDENCE=2
SCRAPING_MIN_DISTINCT_SOURCES=1
SCRAPING_MIN_SOURCE_CATEGORIES=1
SCRAPING_MIN_OFFICIAL_SOURCES=1
SCRAPING_MAX_ERROR_RATE=0.75

# API / frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE_URL=/api
PRODUCT_DATA_DIR=data/product
