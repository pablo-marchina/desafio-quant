# Variaveis lidas pelo docker compose ao subir infra/docker-compose.yml
# (project directory = infra/, por isso este .env fica aqui e nao na raiz).
# Copie para infra/.env e gere valores reais - nunca comite infra/.env.

# Postgres proprio do Langfuse (nao e o Postgres do app - cada um tem o seu).
LANGFUSE_DB_PASSWORD=

# openssl rand -hex 32 (precisa ser exatamente 64 chars hex / 256 bits)
LANGFUSE_ENCRYPTION_KEY=
# qualquer string com pelo menos 256 bits de entropia
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=

LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=

LANGFUSE_MINIO_ROOT_USER=
LANGFUSE_MINIO_ROOT_PASSWORD=

# Headless init: cria org/projeto/usuario com estas chaves no primeiro boot,
# sem precisar abrir a UI do Langfuse manualmente. As mesmas chaves vao para
# LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY no .env da raiz (app FastAPI).
LANGFUSE_INIT_ORG_ID=ai-venture-radar
LANGFUSE_INIT_ORG_NAME=AI Venture Radar
LANGFUSE_INIT_PROJECT_ID=ai-venture-radar-local
LANGFUSE_INIT_PROJECT_NAME=AI Venture Radar (local)
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
