<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<title>Briefing executivo</title>
<style>
  body { font-family: "Segoe UI", Arial, sans-serif; color: #1a2233; margin: 2.5cm 2cm; line-height: 1.5; }
  h1, h2, h3 { color: #0b3d2e; }
  h1 { font-size: 22pt; border-bottom: 2px solid #76b900; padding-bottom: 8px; }
  h2 { font-size: 15pt; margin-top: 24px; }
  a { color: #0b6e4f; text-decoration: none; }
  table { border-collapse: collapse; width: 100%; }
  th, td { border: 1px solid #d0d5dd; padding: 6px 10px; text-align: left; }
  .meta { color: #5b6470; font-size: 9pt; margin-bottom: 16px; }
</style>
</head>
<body>
  <p class="meta">Gerado em {{ generated_at }} &middot; ID da startup: {{ startup_id }}</p>
  {{ body|safe }}
</body>
</html>
