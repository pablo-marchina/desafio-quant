# Infrastructure
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/radar
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=chunk_embeddings
REDIS_URL=redis://localhost:6379

# External APIs
FIRECRAWL_API_KEY=
LLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search

# Observability (Langfuse self-hosted - ver infra/.env.example)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3300

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
STARTUP_DISCOVERY_MAX_PER_RUN=20
STARTUP_DISCOVERY_SCHEDULER_ENABLED=false
STARTUP_DISCOVERY_SCHEDULER_INTERVAL_SECONDS=604800
STARTUP_DISCOVERY_SCHEDULER_RUN_ON_STARTUP=false
SCRAPING_STARTUP_TIMEOUT_SECONDS=90
SCRAPING_REFERENCE_TIMEOUT_SECONDS=120
